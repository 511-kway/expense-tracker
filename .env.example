# Локальная разработка: скопируйте в .env и заполните (docs/dev.md). .env в репозиторий не коммитится.
# Прод на сервере настраивается отдельно: deploy/.env.example (docs/deploy.md).

# Email владельца: ему разрешён вход (app_users.allowed = true), см. ADR-0007.
ADMIN_EMAIL=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
