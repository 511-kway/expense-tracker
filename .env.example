# Скопируйте в .env на сервере и заполните. .env в репозиторий не коммитится.

# Email владельца: ему разрешён вход (app_users.allowed = true), см. ADR-0007.
ADMIN_EMAIL=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Публичный адрес приложения (для OAuth redirect), например https://money.example.com
SITE_URL=
