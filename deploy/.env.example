# Прод-окружение: скопируйте в deploy/.env на сервере (chmod 600), значения не коммитятся.
# Секреты заполняет ./deploy/gen-secrets.sh (только пустые строки, существующие не трогает).
# Остальное вписываете сами. Постоянные настройки Supabase в deploy/supabase.env.

## Сайт

# Домен без схемы и слеша, A-запись на IP сервера, например money.example.com.
# Из него собираются https://DOMAIN (фронт и API), redirect Google и адреса GoTrue.
DOMAIN=
# Email для Let's Encrypt (уведомления об истечении сертификата).
ACME_EMAIL=
# Email владельца: ему разрешён вход (app_users.allowed = true, ADR-0007). Деплой ставит его каждый раз.
ADMIN_EMAIL=

## Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, Web application;
## origin https://DOMAIN, redirect https://DOMAIN/auth/v1/callback; см. docs/deploy.md)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## Секреты Supabase (генерирует ./deploy/gen-secrets.sh)

# Пароль Postgres для всех служебных ролей (hex, без символов, ломающих postgres:// URL).
POSTGRES_PASSWORD=
# Общий секрет подписи JWT (HS256), минимум 32 символа. Смена = новые ANON_KEY и SERVICE_ROLE_KEY.
JWT_SECRET=
# Публичный ключ роли anon (JWT, подписан JWT_SECRET). Попадает в сборку фронта, это нормально.
ANON_KEY=
# Ключ роли service_role (JWT, подписан JWT_SECRET): обходит RLS. Только на сервере.
SERVICE_ROLE_KEY=
# Вход в Studio (basic auth шлюза; Studio открывается только через SSH-туннель).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Realtime и Supavisor: ключ шифрования сессий, минимум 64 символа.
SECRET_KEY_BASE=
# Realtime: ключ шифрования полей схемы _realtime, ровно 16 символов.
REALTIME_DB_ENC_KEY=
# Supavisor: ключ шифрования конфигурации, ровно 32 символа (пулер выключен, но compose его требует).
VAULT_ENC_KEY=
# Studio ↔ postgres-meta: ключ шифрования строк подключения, минимум 32 символа.
PG_META_CRYPTO_KEY=
# Storage: ключи S3-протокола (сам протокол наружу не открыт, но значения должны быть случайными).
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

## Необязательно (пусто = значение из deploy/supabase.env или по умолчанию)

# Ветка, которую выкатывает scripts/deploy.sh (по умолчанию main).
DEPLOY_BRANCH=
# Переопределить значения из supabase.env: раскомментируйте строку. Пустая строка здесь затёрла бы
# значение из supabase.env, поэтому они закомментированы.
# Каталог данных Postgres и Storage (абсолютный путь, по умолчанию /var/lib/expense-tracker).
# DATA_DIR=
# Порт шлюза API на 127.0.0.1 (по умолчанию 8000), на него же SSH-туннель к Studio.
# API_GW_HTTP_PORT=
