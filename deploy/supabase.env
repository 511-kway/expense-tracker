# Постоянные настройки self-hosted Supabase для этого проекта. Секретов здесь нет, файл в git.
# Читается первым, затем deploy/.env (секреты и адрес сайта): значение из .env побеждает.
# Имена переменных те же, что в deploy/supabase/docker-compose.yml (upstream .env.example).
# Адреса сайта (SITE_URL, API_EXTERNAL_URL, SUPABASE_PUBLIC_URL) здесь пустые: их из DOMAIN
# собирает docker-compose.prod.yml.

# Postgres внутри docker-сети (порт наружу не публикуется).
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Где на сервере лежат данные Postgres и файлы Storage (вне git checkout, чтобы git clean их не задел).
DATA_DIR=/var/lib/expense-tracker

# Шлюз API (Envoy) слушает только 127.0.0.1:${API_GW_HTTP_PORT}: снаружи к нему ходит Caddy по
# docker-сети, а Studio открывается через SSH-туннель на этот порт.
API_GW_HTTP_PORT=8000

# Пулер Supavisor выключен (профиль `pooler` в docker-compose.prod.yml): одному пользователю он не
# нужен, а upstream публикует его порты на 0.0.0.0. Значения нужны только чтобы compose не ругался.
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=expense-tracker
POOLER_DB_POOL_SIZE=5

# Studio (только через SSH-туннель, см. docs/deploy.md).
STUDIO_DEFAULT_ORGANIZATION=Expense Tracker
STUDIO_DEFAULT_PROJECT=Expense Tracker
OPENAI_API_KEY=

# Auth (GoTrue): вход только через Google (ADR-0007). Email, телефон и анонимный вход выключены;
# регистрация включена, иначе посторонний не попадёт в лист ожидания.
SITE_URL=
ADDITIONAL_REDIRECT_URLS=
API_EXTERNAL_URL=
SUPABASE_PUBLIC_URL=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=

# Новые ключи (sb_publishable/sb_secret, ES256) не используются: фронт и функции на legacy
# anon/service_role JWT, подписанных JWT_SECRET. Пустой JWT_JWKS = PostgREST берёт JWT_SECRET.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_JWKS=

# Storage: файловый бэкенд в ${DATA_DIR}/storage.
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true

# Edge Functions: JWT проверяется у всех функций, кроме перечисленных с `verify_jwt = false`
# в supabase/config.toml (сейчас claude_ingest), см. deploy/functions-main/index.ts.
FUNCTIONS_VERIFY_JWT=true

# PostgREST: как в supabase/config.toml ([api]).
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
